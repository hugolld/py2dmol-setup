# make_html.py
# /// script
# requires-python = ">=3.11"
# dependencies = ["py2Dmol @ git+https://github.com/sokrypton/py2Dmol"]
# ///
"""Generate a self-contained py2Dmol viewer HTML for PDB 6MRR (SARS-CoV-2 RBD in
complex with human ACE2).

Richardson-style cartoon (hand-drawn look), chain color mode (each chain a
different color), transparent background (py2Dmol default).
"""
from py2Dmol import view

viewer = view(size=(700, 700), style="cartoon", color="chain")
viewer.from_pdb("6MRR")

html = viewer._display_viewer(static_data=viewer.objects)
# Ensure it is a standalone document if the fragment lacks <html>
if "<html" not in html.lower():
    html = (
        "<!DOCTYPE html><html><head><meta charset='utf-8'>"
        "<style>body{margin:0;background:transparent}</style></head><body>"
        + html
        + "</body></html>"
    )

out = "6mrr_richardson.html"
with open(out, "w") as f:
    f.write(html)
print(f"wrote {out} ({len(html)} chars); viewer_id={viewer.config['viewer_id']}")

---
# capture.py
# /// script
# requires-python = ">=3.11"
# dependencies = ["playwright"]
# ///
"""Headless-export a py2Dmol viewer HTML to transparent 300-dpi PNG + SVG.

Drives the viewer's browser-side renderer API (window.py2dmol_viewers[id].
renderer.saveImage) via Playwright with the installed Google Chrome.
"""
import pathlib
from playwright.sync_api import sync_playwright

HTML = pathlib.Path("6mrr_richardson.html").resolve()
PNG = "6mrr_richardson_chain_300dpi.png"
SVG = "6mrr_richardson_chain.svg"

with sync_playwright() as p:
    browser = p.chromium.launch(channel="chrome", headless=True)
    ctx = browser.new_context(accept_downloads=True, viewport={"width": 1000, "height": 1000})
    page = ctx.new_page()
    page.goto(HTML.as_uri())
    page.wait_for_function(
        "() => window.py2dmol_viewers && Object.keys(window.py2dmol_viewers).length > 0"
    )
    vid = page.evaluate("() => Object.keys(window.py2dmol_viewers)[0]")
    print("viewer id:", vid)
    page.wait_for_function(
        """(vid) => {
              const r = window.py2dmol_viewers[vid].renderer;
              return r && r.canvas && r.objectsData && Object.keys(r.objectsData).length > 0;
           }""",
        arg=vid,
    )
    page.wait_for_timeout(3000)  # let the first render settle

    with page.expect_download(timeout=120000) as dl:
        page.evaluate(
            "(vid) => window.py2dmol_viewers[vid].renderer.saveImage({format: 'png', dpi: 300})",
            vid,
        )
    dl.value.save_as(PNG)
    print("saved", PNG, "(suggested:", dl.value.suggested_filename + ")")

    with page.expect_download(timeout=120000) as dl:
        page.evaluate(
            "(vid) => window.py2dmol_viewers[vid].renderer.saveImage({format: 'svg'})",
            vid,
        )
    dl.value.save_as(SVG)
    print("saved", SVG, "(suggested:", dl.value.suggested_filename + ")")

    browser.close()
print("done")
